# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Local development (no cloud needed) ---
# DuckDB file used by the ingestion "duckdb" sink and the dbt "local" target.
DUCKDB_PATH=data/elkollen.duckdb

# --- Ingestion ---
# Sent as User-Agent to the price API so the operator can identify the client.
ELKOLLEN_USER_AGENT=elkollen/0.1 (+https://github.com/<you>/elkollen)

# --- Snowflake (Terraform admin) ---
# Used only by `terraform plan/apply`. Snowflake provider v2 reads these names.
SNOWFLAKE_ORGANIZATION_NAME=
SNOWFLAKE_ACCOUNT_NAME=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_PRIVATE_KEY_PATH=

# --- Snowflake (runtime service users created by Terraform) ---
# Account identifier in <org>-<account> form, used by the Python connector and dbt.
ELKOLLEN_SF_ACCOUNT=
ELKOLLEN_SF_DATABASE=ELKOLLEN
ELKOLLEN_SF_WAREHOUSE=ELKOLLEN_WH
# Loader (ingestion writes RAW)
ELKOLLEN_SF_LOADER_USER=ELKOLLEN_LOADER_SVC
ELKOLLEN_SF_LOADER_PRIVATE_KEY_PATH=
# Transformer (dbt reads RAW, writes STAGING/MARTS)
ELKOLLEN_SF_TRANSFORMER_USER=ELKOLLEN_TRANSFORMER_SVC
ELKOLLEN_SF_TRANSFORMER_PRIVATE_KEY_PATH=
# Reader (API and MCP server read MARTS only)
ELKOLLEN_SF_READER_USER=ELKOLLEN_READER_SVC
ELKOLLEN_SF_READER_PRIVATE_KEY_PATH=

# --- API and MCP server (phase 3) ---
# Where they read from: duckdb (local, uses DUCKDB_PATH) or snowflake (READER user).
ELKOLLEN_WAREHOUSE=duckdb
# Shared secret for the short-lived tokens the web app mints for the backend.
# At least 32 random bytes, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
ELKOLLEN_JWT_SECRET=
ELKOLLEN_WEB_ORIGIN=http://localhost:3000
ELKOLLEN_AUTH_ISSUER=http://localhost:3000
ELKOLLEN_MCP_URL=http://127.0.0.1:8001/mcp
